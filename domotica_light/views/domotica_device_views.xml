<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_domotica_device_form" model="ir.ui.view">
        <field name="model">domotica.light</field>
        <field name="inherit_id" ref="domotica.view_domotica_device_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='kind_of_domotica']" position="after">
                <field name="is_light"/>
            </xpath>
        </field>
    </record>

</odoo>