<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="module_category_domotica" model="ir.module.category">
        <field name="name">Domotica</field>
        <field name="description">User access levels for Domotica module</field>
    </record>

    <record id="privilige_domotica" model="res.groups.privilege">
        <field name="name">Domotica</field>
        <field name="category_id" ref="module_category_domotica"/>
    </record>

    <record id="group_domotica_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilige_domotica"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>


</odoo>