<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="s_weather" name="Weather Forecast Snippet">
        <section class="pt32 pb32 s_weather" data-location-name="Brussels">
            <div class="container">
                <h2 class="h5"><span class="weather-location-name o_not_editable"/>'s Weather
                </h2>
                <label for="weather-location-input" class="o_not_editable">
                    What's the weather in:
                    <input id="weather-location-input" name="weather-location-input" type="text"/>
                </label>
                <div class="align-items-center my-3 weather-cards-container o_not_editable"/>
            </div>
        </section>
    </template>

</odoo>
