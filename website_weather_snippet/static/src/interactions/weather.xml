<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="website_weather_snippet.s_weather.cards">
        <t t-foreach="days" t-as="day" t-key="day.date">
            <div class="card col mx-2 p-0">
                <img class="card-img-top img-fluid"
                     t-attf-src="/website_weather_snippet/static/src/img/#{day.img}.svg"
                     t-att-alt="day[1]"/>
                <div class="card-body">
                    <h3 class="h6 card-subtitle" t-out="day.date"/>
                    <p class="h5 card-title">
                        <t t-out="day.temp"/>°C
                    </p>
                </div>
            </div>
        </t>
    </t>

    <t t-name="website_weather_snippet.s_weather.not_found">
        <div class="col">
            <p class="text-center text-muted">No weather was found for this location</p>
        </div>
    </t>

</templates>
